# Copy to .env and fill in. Never commit .env. Synthetic data only.

# --- Database (Neon Postgres + pgvector) ---
# Neon console > your project > Connect > copy the connection string (pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Optional: a login that holds the read-only report_ro role, used only for the auditor's group charts.
# Leave unset to use DATABASE_URL (fine for local work).
# REPORT_DATABASE_URL=postgresql://REPORT_USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- LLM providers (free tiers, called through LiteLLM) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://build.nvidia.com (Get API Key)
NVIDIA_API_KEY=
# Free fallback via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Observability (Langfuse cloud free tier, optional until Stage 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# false = never send traces (CI and tests set this). Traces carry tokens, cost, latency, scores only.
LANGFUSE_ENABLED=true
# Tempo traces: http://localhost:4317 once the stack in ops/ is up (leave empty to skip)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana admin password for ops/docker-compose.observability.yml (default: admin)
GRAFANA_ADMIN_PASSWORD=

# --- App ---
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
MAX_CASE_UPLOAD_MB=60
# Intake desk and applicant upload link (Stage 10). One bulk upload may hold this many files,
# zip contents included.
MAX_FILES_PER_UPLOAD=60
# The applicant's link: days it stays open, the address the applicant page is served from (the link
# is this plus /u#token), the files one link may add, and the public rate limits.
UPLOAD_LINK_DAYS=7
PUBLIC_BASE_URL=http://localhost:5173
LINK_MAX_FILES=80
LINK_RATE_PER_MINUTE=30
ADDRESS_RATE_PER_MINUTE=90
# API (Stage 6). LLM_ENABLED=false makes the pipeline write report text in code (no model calls).
LLM_ENABLED=true
# Sessions (SECURITY.md 4a): a 15-minute access token renewed while the person works, signed out
# after 30 idle minutes, and a hard stop 12 hours after sign-in whatever the activity.
ACCESS_TOKEN_MINUTES=15
IDLE_TIMEOUT_MINUTES=30
IDLE_WARNING_MINUTES=2
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Only if the frontend is served from another origin (comma separated)
CORS_ORIGINS=
# Customer messages (Stage 9). v1 only prints them in the backend terminal.
NOTIFICATION_SENDER=console
# Optional branch contact lines added to every customer message (leave empty to omit)
BRANCH_CONTACT_EMAIL=
BRANCH_CONTACT_PHONE=
