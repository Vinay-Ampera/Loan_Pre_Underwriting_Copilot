# Copy to .env and fill in. Never commit .env. Synthetic data only.
# The same file serves `make backend` on your machine and `docker compose up` (README.md).

# --- Database (Neon Postgres + pgvector) ---
# Neon console > your project > Connect > copy the connection string (pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Offline instead (Docker only): `docker compose --profile local-db up` starts Postgres with
# pgvector in the stack; then set
# DATABASE_URL=postgresql://postgres:postgres@db:5432/pramaan
# Optional: a login that holds the read-only report_ro role, used only for the auditor's group charts.
# Leave unset to use DATABASE_URL (fine for local work).
# REPORT_DATABASE_URL=postgresql://REPORT_USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- LLM providers (free tiers, called through LiteLLM) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://build.nvidia.com (Get API Key)
NVIDIA_API_KEY=
# Free fallback via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Observability (Langfuse cloud free tier; optional, never self-hosted in this stack) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# false = never send traces (CI and tests set this). Traces carry tokens, cost, latency, scores only.
LANGFUSE_ENABLED=true
# Tempo traces: http://localhost:4317 once the stack in ops/ is up (leave empty to skip).
# Inside `docker compose up` the app uses http://tempo:4317 by itself.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana admin password (Docker stack and ops/docker-compose.observability.yml; default: admin)
GRAFANA_ADMIN_PASSWORD=

# --- App ---
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
MAX_CASE_UPLOAD_MB=60
# Intake desk and applicant upload link (Stage 10). One bulk upload may hold this many files,
# zip contents included.
MAX_FILES_PER_UPLOAD=60
# Several documents in one PDF (Stage 10, Part D). false = a multi-page PDF is one document, as before.
# A bundle may have more pages and bytes than a single document.
BUNDLE_SPLIT_ENABLED=true
BUNDLE_MAX_PAGES=120
BUNDLE_MAX_MB=25
# The applicant's link: days it stays open, the address the applicant page is served from (the link
# is this plus /u#token), the files one link may add, and the public rate limits.
UPLOAD_LINK_DAYS=7
PUBLIC_BASE_URL=http://localhost:5173
LINK_MAX_FILES=80
LINK_RATE_PER_MINUTE=30
ADDRESS_RATE_PER_MINUTE=90
# API (Stage 6). LLM_ENABLED=false makes the pipeline write report text in code (no model calls).
LLM_ENABLED=true
# Sessions (SECURITY.md 4a): a 15-minute access token renewed while the person works, signed out
# after 30 idle minutes, and a hard stop 12 hours after sign-in whatever the activity.
ACCESS_TOKEN_MINUTES=15
IDLE_TIMEOUT_MINUTES=30
IDLE_WARNING_MINUTES=2
SESSION_MAX_HOURS=12
# A refresh that arrives this many seconds after the token was renewed is still accepted (two tabs)
REFRESH_GRACE_SECONDS=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 2-step verification (SECURITY.md 4h): these roles must give a 6-digit code from an authenticator
# app (Google Authenticator, Microsoft Authenticator or any other) after the password, and set it up at their first sign-in. Officers
# are not on the list for now. Wrong codes count toward LOGIN_MAX_FAILURES like wrong passwords.
# The stored setup key is sealed with a key derived from JWT_SECRET: changing JWT_SECRET means
# every 2-step account signs in with a recovery code or is reset from the command line.
MFA_ROLES=admin,auditor
# Minutes between a correct password and the code before the person starts again
MFA_TOKEN_MINUTES=5
# Only if the frontend is served from another origin (comma separated)
CORS_ORIGINS=
# Customer messages and staff email (Stage 9, Notifications Part 2).
# console = print in the terminal (default, no email leaves the machine)
# smtp    = really send by email (Notifications Part 2), only to EMAIL_ALLOWLIST
NOTIFICATION_SENDER=console

# ---- Real email (Notifications Part 2) -------------------------------------------------------
# Read only when NOTIFICATION_SENDER=smtp. Resend over SMTP:
SMTP_HOST=smtp.resend.com
# 465 with SMTP_SECURITY=ssl, or 587 with SMTP_SECURITY=starttls
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=resend
SMTP_TIMEOUT_SECONDS=15
# Your Resend API key (starts with re_). Put it in .env only, never in git or in a chat.
SMTP_PASSWORD=
# Without a domain verified in Resend, use onboarding@resend.dev: it delivers only to the
# address the Resend account was opened with.
EMAIL_FROM=Pramaan <onboarding@resend.dev>
# Exact addresses that may really receive email, comma separated (your own inbox, and
# delivered@resend.dev for a test that goes nowhere). Data is synthetic, so nothing else may.
EMAIL_ALLOWLIST=
# Demo only: email for an address not on the list goes here instead (one of the addresses
# above), with the intended recipient masked in the subject. Empty = it is not sent at all,
# only printed in the terminal.
EMAIL_REDIRECT_TO=
# Staff emails ("you have a new notice, sign in"; "your account was created"). Each person
# can turn the notice emails off; this is the starting value for new accounts.
STAFF_EMAILS_DEFAULT=true
# How often queued staff email is sent (seconds; 0 = never), and at most one "new notice" email
# per person in this many minutes. A failed email is tried again after 1, then 5 minutes.
EMAIL_WORKER_SECONDS=15
NOTICE_EMAIL_GAP_MINUTES=30

# Local alternative while developing: Mailpit catches every email in a web page, nothing leaves.
# SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURITY=none  SMTP_USERNAME=  SMTP_PASSWORD=
# Optional branch contact lines added to every customer message (leave empty to omit)
BRANCH_CONTACT_EMAIL=
BRANCH_CONTACT_PHONE=

# --- Retention (Stage 11, SECURITY.md 7) ---
# The app runs the retention job this often (hours; 0 = never; by hand: python -m app.db.retention).
RETENTION_HOURS=24
# Bureau-derived values are removed this long after a case was made.
BUREAU_RETENTION_MONTHS=6
# Sent, held or failed staff email rows are deleted after this many days.
EMAIL_RETENTION_DAYS=90

# --- Decision timer (Stage 12 Part C, IMPLEMENTATION_PLAN.md) ---
# The officer decides within this many working days (Monday to Friday, holidays not counted) of
# the report being ready. Overdue cases get a badge, one notice to the officer, and one to the
# admins a working day later.
SLA_WORKING_DAYS=2
# The bank's calendar for working days and "due today".
SLA_TIMEZONE=Asia/Kolkata
# How often the app checks for overdue cases (minutes; 0 = never).
SLA_CHECK_MINUTES=15

# --- "Ask this case" chat (Stage 12 Part E, SECURITY.md 4i) ---
# Questions one person may ask in an hour (protects the free model tiers).
CHAT_MAX_PER_HOUR=20
# Stored questions and answers (masked) are deleted after this many days.
CHAT_RETENTION_DAYS=90
